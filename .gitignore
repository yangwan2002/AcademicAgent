# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.hypothesis/

# 运行时 working copy / 会话状态
.paper_workspace/

# 转换产出
output/

# 运行追踪（trace.json / event journal）
runs/

# 环境
.env
.venv/
venv/

# A/B 实验输出：一次性对照结果，随跑随生成，不进版本控制。
# （结论应落到 spec 或 backlog，不是把原始输出留在仓库里）
# 不限后缀：三臂 A/B 的生成正文是 ab_gen_*.md，同属一次性产物。
tests/eval/**/ab_*

# 排障时随手重定向的 pytest 输出 / 事实文件备份（`_x.txt`、`_x.bak.json`）。
# 曾有 5 个这类文件被误提交，故按模式挡住。
/_*.txt
/_*.bak.json
