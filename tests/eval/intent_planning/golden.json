      "expected": {
        "operations": [{"intent": "rewrite", "target_hint": "1 引言"}],
        "constraints": [],
        "atomic_requirements": ["完善我的引言部分", "参考文献10", "英文8", "中文2"],
        "expected_unmapped": []
